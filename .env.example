# Сайт Goldfish: вход через Яндекс ID, скачивание расширения, выдача доступа к серверу агента.
# Пустое значение = не задано.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Адрес сайта, как его открывают пользователи (https в продакшене). Из него строится
# Redirect URI для Яндекс ID: <PUBLIC_URL>/auth/yandex/callback
PUBLIC_URL=https://goldfish.example.ru

# PostgreSQL. В docker compose задаётся автоматически; в App Platform — строка управляемой базы.
# Без неё (только разработка) пользователи и сессии живут в памяти.
DATABASE_URL=
# Пароль базы в docker compose.
POSTGRES_PASSWORD=change-me
# Сколько дней действует вход на сайт.
SESSION_DAYS=30

# Приложение Яндекс ID (https://oauth.yandex.ru/client/new): ClientID и Client secret.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Сервер Goldfish, к которому подключается расширение (этот адрес видит пользователь).
GOLDFISH_URL=https://agent.example.ru
# Откуда сайт ходит в API оператора; по умолчанию GOLDFISH_URL. Сервер на той же машине:
# http://host.docker.internal:8080
GOLDFISH_ADMIN_URL=
# ADMIN_TOKEN сервера Goldfish. Даёт полный доступ к серверу — храните как пароль.
GOLDFISH_ADMIN_TOKEN=
# Клиент (компания) Goldfish, в котором живут пользователи сайта. Без GOLDFISH_CLIENT_ID сайт
# найдёт клиента по имени или создаст его.
GOLDFISH_CLIENT_ID=
GOLDFISH_CLIENT_NAME=Сайт

# Свой zip расширения; без него сайт отдаёт пакет с GOLDFISH_URL/extension/download.
EXTENSION_ZIP=

# Ссылки в подвале (необязательно).
PRIVACY_URL=
SUPPORT_EMAIL=

# Caddy (docker compose --profile caddy): домен сайта.
SITE_DOMAIN=goldfish.example.ru
